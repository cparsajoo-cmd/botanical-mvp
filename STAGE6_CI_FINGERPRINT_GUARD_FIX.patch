+def _report_ready_matches_current_pipeline(report_ready_df) -> bool:
+    """Validate production Stage-5 provenance without coupling the renderer to session state."""
+    if not isinstance(report_ready_df, pd.DataFrame) or report_ready_df.empty:
+        return True
+    if "Pipeline_Implementation_Fingerprint" not in report_ready_df.columns:
+        return False
+    report_fingerprints = set(
+        report_ready_df["Pipeline_Implementation_Fingerprint"]
+        .dropna().astype(str).str.strip().tolist()
+    )
+    return report_fingerprints == {_pipeline_implementation_fingerprint()}
